const SHEET_NAME = 'Sheet1';
const SPREADSHEET_ID = '1_mCd4rIPCbcrCUInGNZjf8LSLmJ3HMPe0gwlRW3c97M';
function getSheet_(){const sheet=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);if(!sheet)throw Error('Sheet1 not found');return sheet}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(10000);const data=e.parameter && e.parameter.id ? e.parameter : JSON.parse(e.postData.contents);const id=String(data.id||'');const name=String(data.name||'Napisah');const date=String(data.date||'');const time=String(data.time||'');if(!/^[a-zA-Z0-9_-]{8,100}$/.test(id))throw Error('Invalid request ID');if(!/^2026-10-(1[3-9]|20)$/.test(date))throw Error('Invalid date');if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(time))throw Error('Invalid time');const sheet=getSheet_();if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,5).clearContent();sheet.getRange(2,1,1,5).setValues([[new Date(),name,date,time,id]]);SpreadsheetApp.flush();return json_({success:true})}catch(err){console.error(err);return json_({success:false,error:String(err.message||err)})}finally{if(lock.hasLock())lock.releaseLock()}}
function doGet(e){const p=e.parameter||{};if(p.action!=='status')return json_({success:false,error:'Unknown action'});const callback=String(p.callback||'');if(!/^[a-zA-Z_$][a-zA-Z0-9_$]{0,90}$/.test(callback))return json_({success:false,error:'Invalid callback'});let result;try{const id=String(p.id||'');if(!/^[a-zA-Z0-9_-]{8,100}$/.test(id))throw Error('Invalid request ID');const sheet=getSheet_();const saved=sheet.getLastRow()>1&&String(sheet.getRange(2,5).getValue())===id;result={saved:saved}}catch(err){result={saved:false,error:String(err.message||err)}}return ContentService.createTextOutput(callback+'('+JSON.stringify(result)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function json_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON)}
function testConnection(){Logger.log('Connected to: '+getSheet_().getName())}
